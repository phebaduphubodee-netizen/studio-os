.env
.env.*
!.env.example
*.pem
*.key
.claude/settings.local.json
CLAUDE.local.md
# tools/ AI daily-cost counters (project-local state)
.gemini_usage.json
.openai_usage.json
.perplexity_usage.json
logs/
pipeline/output/
# raw client intake documents (identifying: names, addresses, plan title blocks)
# stay LOCAL-ONLY — anonymized derivatives (brief.json, specs) are what gets committed
projects/*/00_intake/raw-local/
__pycache__/
*.pyc
.venv/
venv/
node_modules/
.DS_Store
Thumbs.db
# editor state (Obsidian opened on the repo)
.obsidian/
# private client/business pulls (Discord: names, tax docs, pricing) — LOCAL-ONLY, never committed
_private/
# Discord knowledge pull: commit text + LFS-eligible binaries (pdf/skp/zip); keep raw images
# LOCAL-ONLY — png/jpg aren't LFS-tracked (.gitattributes is frozen) and total ~200MB. Re-pull via
# scripts/discord_ingest.py. Distilled numbers already live in the committed vault files.
knowledge/_inbox/discord/**/*.png
knowledge/_inbox/discord/**/*.jpg
knowledge/_inbox/discord/**/*.jpeg
knowledge/_inbox/discord/**/*.rar
# two image attachments whose Thai CDN filename lost its extension (still images, keep local)
knowledge/_inbox/discord/**/files/145779_*
knowledge/_inbox/discord/**/files/383192_*
# mutation_probe.py parks the reader's pre-probe bytes here while it mutates; a killed probe
# leaves it behind ON PURPOSE (hand-restore evidence) — it must never be sweepable into a commit
*.probe-backup

# client-derived CLIP embedding banks (Stage B2) -- never commit
*embed-bank*.npz
*.embedbank.npz

# 3D Warehouse models — Trimble General Model License: free to USE, NOT
# redistributable AS MODELS. A model that may not be redistributed must not
# enter version control. Fetch is reproducible from the entity id instead
# (pipeline/scripts/warehouse.py, and every consuming spec records the id).
assets/shared/warehouse/
